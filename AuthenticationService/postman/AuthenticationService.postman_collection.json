    {
      "name": "02 - Login",
      "item": [
        {
          "name": "Login USER - 200 + token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('returns token and role', () => {",
                  "  pm.expect(body.token, 'token missing').to.be.a('string').and.not.empty;",
                  "  pm.expect(body.role).to.eql('USER');",
                  "});",
                  "",
                  "pm.test('token is a well-formed JWT with the expected claims', () => {",
                  "  const parts = String(body.token).split('.');",
                  "  pm.expect(parts.length, 'not a three-part JWT').to.eql(3);",
                  "",
                  "  const CryptoJS = require('crypto-js');",
                  "  let b64 = parts[1].replace(/-/g, '+').replace(/_/g, '/');",
                  "  while (b64.length % 4) { b64 += '='; }",
                  "  const claims = JSON.parse(CryptoJS.enc.Utf8.stringify(CryptoJS.enc.Base64.parse(b64)));",
                  "",
                  "  pm.expect(claims.sub, 'subject should be the email').to.eql(pm.collectionVariables.get('userEmail'));",
                  "  pm.expect(claims.role).to.eql('USER');",
                  "  pm.expect(claims.exp - claims.iat, 'token should last 24h').to.eql(86400);",
                  "});",
                  "",
                  "pm.test('password hash is never returned', () => {",
                  "  pm.expect(Object.keys(body)).to.not.include('password');",
                  "});",
                  "",
                  "pm.collectionVariables.set('userToken', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
