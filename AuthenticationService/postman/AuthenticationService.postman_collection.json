{
  "info": {
    "name": "AuthenticationService (port 8083)",
    "description": "End-to-end tests for the JobApplication AuthenticationService.\n\nRun the whole collection in order with the Collection Runner - later requests reuse ids, tokens and emails captured by earlier ones.\n\nEach run generates a fresh runId so emails are unique and the suite is re-runnable without cleaning the DB.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8083" },
    { "key": "password", "value": "Admin@123" },
    { "key": "runId", "value": "" },
    { "key": "userEmail", "value": "" },
    { "key": "hiringEmail", "value": "" },
    { "key": "adminEmail", "value": "" },
    { "key": "userToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "hiringToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "hiringId", "value": "" }
  ],
  "item": [
    {
      "name": "00 - Smoke",
      "item": [
        {
          "name": "GET /test - service is up (seeds run data)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fresh identities per run so the suite is repeatable",
                  "const runId = String(Date.now()).slice(-7);",
                  "pm.collectionVariables.set('runId', runId);",
                  "pm.collectionVariables.set('userEmail', 'qa.user.' + runId + '@example.com');",
                  "pm.collectionVariables.set('hiringEmail', 'qa.hiring.' + runId + '@example.com');",
                  "pm.collectionVariables.set('adminEmail', 'qa.admin.' + runId + '@example.com');",
                  "console.log('Run ID: ' + runId);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('returns the smoke-test banner', () => {",
                  "  pm.expect(pm.response.text()).to.eql('JWT Authentication Working!');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/test", "host": ["{{baseUrl}}"], "path": ["test"] }
          }
        },
        {
          "name": "GET /actuator/health - UP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('status is UP', () => {",
                  "  pm.expect(pm.response.json().status).to.eql('UP');",
                  "});",
                  "pm.test('datasource is reachable', () => {",
                  "  const db = pm.response.json().components && pm.response.json().components.db;",
                  "  pm.expect(db, 'db health component missing').to.not.be.undefined;",
                  "  pm.expect(db.status).to.eql('UP');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "health"]
            }
          }
        }
      ]
    },
